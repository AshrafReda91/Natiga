<?xml version="1.0" encoding="utf-8"?>
<!-- مستوحى من نتيجة الحيطة المصرية:
     النص اليمين = القبطي، النص الشمال = الميلادي والهجري، وتحتهم تأمل الشهر القبطي.
     كل النصوص صور بيرسمها TextArt بخط Tajawal/Carlito، ولونها من android:tint -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="1.5dp"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- الشريط العلوي: اسم اليوم + الموسم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_strip"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="7dp"
        android:paddingEnd="16dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/day_name"
            style="@style/WidgetText"
            android:tint="@color/strip_text" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/season"
            style="@style/WidgetText"
            android:tint="@color/strip_text" />
    </LinearLayout>

    <!-- التواريخ: يمين قبطي | شمال ميلادي وهجري -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <!-- النص اليمين: القبطي -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/day_num"
                style="@style/WidgetText"
                android:tint="@color/ink" />

            <ImageView
                android:id="@+id/day_num_friday"
                style="@style/WidgetText"
                android:tint="@color/friday"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/coptic"
                style="@style/WidgetText"
                android:layout_marginTop="4dp"
                android:tint="@color/ink" />
        </LinearLayout>

        <!-- فاصل رأسي -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="60dp"
            android:background="@color/divider" />

        <!-- النص الشمال: الميلادي والهجري (خلفية ذهبي في الأيام البيض) -->
        <LinearLayout
            android:id="@+id/greg_hijri_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/gregorian"
                style="@style/WidgetText"
                android:tint="@color/ink" />

            <ImageView
                android:id="@+id/hijri"
                style="@style/WidgetText"
                android:layout_marginTop="4dp"
                android:tint="@color/ink_soft" />

            <ImageView
                android:id="@+id/white_day"
                style="@style/WidgetText"
                android:layout_marginTop="3dp"
                android:tint="@color/moon_text"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- فاصل أفقي -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/divider" />

    <!-- تأمل الشهر: يمين المثل والمعنى | شمال التوجيه -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/proverb"
                style="@style/WidgetText"
                android:tint="@color/proverb" />

            <ImageView
                android:id="@+id/theme"
                style="@style/WidgetText"
                android:layout_marginTop="3dp"
                android:tint="@color/ink" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/advice"
                style="@style/WidgetText"
                android:tint="@color/ink_soft" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
