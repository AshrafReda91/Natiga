<?xml version="1.0" encoding="utf-8"?>
<!-- مستوحى من نتيجة الحيطة المصرية: شريط الشهر فوق، رقم اليوم كبير، والهجري والقبطي جنبه -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <TextView
        android:id="@+id/month_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_strip"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="سبتمبر ٢٠٢٦"
        android:textColor="@color/strip_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/day_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:minWidth="64dp"
            android:gravity="center"
            android:text="٢١"
            android:textColor="@color/ink"
            android:textSize="58sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_num_friday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:minWidth="64dp"
            android:gravity="center"
            android:text="٢١"
            android:textColor="@color/friday"
            android:textSize="58sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:layoutDirection="rtl"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="الاثنين"
                android:textColor="@color/ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hijri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="start"
                android:maxLines="1"
                android:text="١٠ ربيع الآخر ١٤٤٨ هـ"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/coptic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:maxLines="1"
                android:text="١١ توت ١٧٤٣ ش"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
