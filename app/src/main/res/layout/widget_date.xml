<?xml version="1.0" encoding="utf-8"?>
<!-- مستوحى من نتيجة الحيطة المصرية:
     النص اليمين = القبطي، النص الشمال = الميلادي والهجري، وتحتهم تأمل الشهر القبطي -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- الشريط العلوي: اسم اليوم + الموسم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_strip"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/day_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الثلاثاء"
            android:textColor="@color/strip_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/season"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:text="أخيت · الفيضان"
            android:textColor="@color/strip_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- التواريخ: يمين قبطي | شمال ميلادي وهجري -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <!-- النص اليمين: القبطي -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="١٢"
                android:textColor="@color/ink"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_num_friday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="١٢"
                android:textColor="@color/friday"
                android:textSize="44sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/coptic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="توت ١٧٤٣ ش"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- فاصل رأسي -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="64dp"
            android:background="@color/divider" />

        <!-- النص الشمال: الميلادي والهجري (خلفية ذهبي في الأيام البيض) -->
        <LinearLayout
            android:id="@+id/greg_hijri_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/gregorian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="٢٢ سبتمبر ٢٠٢٦"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="١٠ ربيع الآخر ١٤٤٨ هـ"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/white_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="🌕 ليلة البدر — اكتمال القمر"
                android:textColor="@color/moon_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- فاصل أفقي -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/divider" />

    <!-- تأمل الشهر القبطي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/proverb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="«توت يقول للحر موت»"
            android:textColor="@color/proverb"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="start"
            android:maxLines="1"
            android:text="التجدد والبداية"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="3"
            android:text="اترك القديم ينتهي. نظّف مساحتك، وجدّد نيتك للدورة الجديدة."
            android:textColor="@color/ink_soft"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
