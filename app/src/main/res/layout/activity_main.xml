<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="start"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:fontFamily="@font/tajawal_bold" />

        <include
            layout="@layout/widget_date"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ضيف الـ widget للشاشة الرئيسية" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="start"
            android:text="تعديل التاريخ الهجري"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:fontFamily="@font/tajawal_bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="start"
            android:text="الحساب على تقويم أم القرى. لو مختلف يوم عن إعلان دار الإفتاء، عدّله من هنا."
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_plus"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="+" />

            <TextView
                android:id="@+id/offset_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="بدون تعديل"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_minus"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="−" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_digits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <!-- accordion: لوحة السنة القبطية اللي منها تأملات الشهور -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/art_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/tajawal_bold"
                    android:gravity="start"
                    android:text="لوحة السنة القبطية — دورة الحياة"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/art_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/frame"
                    android:textSize="20sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/art_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="لوحة السنة القبطية: الشهور الثلاثة عشر وأمثالها ومعانيها"
                android:scaleType="fitCenter"
                android:src="@drawable/coptic_year"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="start"
            android:text="أو ضيفه يدويًا: اضغط مطوّل على الشاشة الرئيسية ← Widgets ← النتيجة"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="start"
            android:text="تأملات الشهور القبطية من لوحة «السنة القبطية — دورة الحياة في انسجام مع الطبيعة» — لقاء الروح، محمد فاروق المليجي. الخطوط: Tajawal وCarlito (رخصة SIL OFL)."
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
